# =============================================================================
# onpremdgxsparkllm - environment variables (example)
# =============================================================================
# Copy this to .env and fill in real values. The .env file is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Hugging Face (required for downloading FP8 model weights from the gated repo)
# -----------------------------------------------------------------------------
HF_TOKEN=hf_xxx_replace_me

# -----------------------------------------------------------------------------
# vLLM image selection
# -----------------------------------------------------------------------------
# Default: locally-built patched image (sm_121 CUTLASS workaround for
# NVIDIA driver < 590.44 on DGX Spark / Blackwell GB10).
# After upgrading the host driver to >= 590.44, switch to NVIDIA's
# Spark-tuned image: nvcr.io/nvidia/vllm:25.12.post1-py3
# VLLM_IMAGE=vllm-patched:qwen3.5

# -----------------------------------------------------------------------------
# vLLM serving (override defaults if needed)
# -----------------------------------------------------------------------------
# VLLM_MODEL_PATH=/models/qwen3-coder-30b-a3b-instruct-fp8
# VLLM_MODEL=qwen3-coder-30b
# VLLM_MAX_MODEL_LEN=262144    # Qwen3-Coder native window; drop to 131072 for 8 concurrent
# VLLM_MAX_NUM_SEQS=4          # raise to 8 if VLLM_MAX_MODEL_LEN=131072, to 16 if 65536
# VLLM_GPU_MEMORY_UTILIZATION=0.70
# VLLM_KV_CACHE_DTYPE=fp8

# -----------------------------------------------------------------------------
# Ollama tuning
# -----------------------------------------------------------------------------
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_CONTEXT_LENGTH=65536

# -----------------------------------------------------------------------------
# Port bindings (defaults to 0.0.0.0 so sibling docker-compose stacks can
# reach us via host.docker.internal. Override to 127.0.0.1 if you ever
# expose this machine to an untrusted network without a perimeter firewall.)
# -----------------------------------------------------------------------------
# VLLM_BIND=0.0.0.0
# OLLAMA_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# NVIDIA visibility (rarely changed; "all" exposes every GPU on the host)
# -----------------------------------------------------------------------------
# NVIDIA_VISIBLE_DEVICES=all

# -----------------------------------------------------------------------------
# Colibrì GLM-5.2 (host-native API on port 8001)
# -----------------------------------------------------------------------------
# Local only (default):
# COLIBRI_BIND=127.0.0.1
#
# Other laptops on the same Wi‑Fi (requires a secret token — not a username):
# COLIBRI_BIND=0.0.0.0
# COLIBRI_PORT=8001
# COLI_API_KEY=choose-a-long-random-secret
#
# Then open the firewall on the Spark (example):
#   sudo ufw allow from 192.168.0.0/16 to any port 8001 proto tcp
# Use your laptop: ANTHROPIC_BASE_URL=http://<spark-lan-ip>:8001
# and the same string for ANTHROPIC_AUTH_TOKEN (leave ANTHROPIC_API_KEY unset).
#
# MTP speculative decoding (faster decode when draft acceptance is good):
# COLI_CUDA_MTP=1
# MTP=1
# SPEC_PIN=1
# COLI_KV_SLOTS=1
# DRAFT=-1
# Set DRAFT=0 to turn speculation off if throughput drops (low expert hit rate).


# -----------------------------------------------------------------------------
# Hybrid edge profile (Qwen interactive lane + asynchronous GLM verifier)
# -----------------------------------------------------------------------------
# QWEN_MODEL_ID=qwen3-coder-30b
# QWEN_API_KEY=local-qwen
# HYBRID_VLLM_MAX_MODEL_LEN=65536
# HYBRID_VLLM_MAX_NUM_SEQS=1
# HYBRID_VLLM_GPU_MEMORY_UTILIZATION=0.30
# GLM_REVIEW_MIN_AVAILABLE_GIB=10
# GLM_REVIEW_MAX_DIFF_CHARS=24000
# GLM_REVIEW_MAX_PACKET_CHARS=7600
# GLM_REVIEW_MAX_TOKENS=192
